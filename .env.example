# ==============================================================================
# ReAA 2.0: Environment Variables Template
# ==============================================================================

# Google Gemini AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Pinecone Vector Database Configuration (Index: 3072 dimensions)
# Get your Pinecone credentials from https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_HOST=https://your-index-host.pinecone.io
PINECONE_INDEX=newreaa
PINECONE_INDEX_NAME=newreaa
PINECONE_NAMESPACE_PROJECTS=rera-projects
PINECONE_NAMESPACE_LEGAL=rera-legal
PINECONE_NAMESPACE_LITIGATION=rera-litigation
PINECONE_NAMESPACE_COMPLAINTS=rera-complaints

# DataStax Astra DB Configuration (Collection: 3072 dimensions, metric: cosine)
# Get your Astra DB credentials from https://astra.datastax.com/
ASTRA_DB_API_ENDPOINT=https://your-database-id-region.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:your_token_here
ASTRA_DB_COLLECTION=rera_links

# Optional UI Overrides
NEXT_PUBLIC_APP_NAME="ReAA 2.0: K-RERA Advisory AI"
